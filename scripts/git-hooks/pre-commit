#!/usr/bin/env bash
# innate-works pre-commit: sync registry.yaml before allowing the commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

python3 scripts/sync-registry.py --quiet

if git diff --quiet -- registry.yaml; then
  exit 0
fi

git add registry.yaml
echo "[pre-commit] registry.yaml updated and staged"
exit 0
