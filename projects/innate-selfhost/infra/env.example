# ===========================================
# innate-selfhost 全局环境变量
# 复制为 .env 后修改：cp env.example .env
# ===========================================

# --- 域名配置 ---
# 懒猫私有云会自动分配子域名，以下为非懒猫环境使用
DOMAIN=localhost
TRAEFIK_DASHBOARD_HOST=traefik.localhost

# --- 时区 ---
TZ=Asia/Shanghai

# --- 数据目录 ---
# Docker volume 数据持久化路径（绝对路径）
DATA_DIR=./data

# --- PostgreSQL（baas 服务）---
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=selfhost

# --- MinIO（baas 对象存储）---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- Authentik（baas 认证）---
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-password
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-authentik-token

# --- PostgREST ---
PGRST_JWT_SECRET=change-me-jwt-secret

# --- Mercure（实时推送）---
MERCURE_JWT_SECRET=change-me-mercure-jwt-secret

# --- Ollama ---
OLLAMA_MODELS=llama3.2,codellama
OLLAMA_HOST=0.0.0.0:11434
