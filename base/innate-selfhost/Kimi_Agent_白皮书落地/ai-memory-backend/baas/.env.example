# ============================================================================
# baas 环境变量示例 —— 复制为 .env 后修改（cp .env.example .env）
# 生产环境请将所有密钥替换为强随机值：openssl rand -base64 32
# ============================================================================

# ---------- PostgreSQL / ParadeDB ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=postgres

# Authentik 自己使用的库（首次启动需手动创建：
#   docker compose exec db psql -U postgres -c "CREATE DATABASE authentik;"）
AUTHENTIK_DB_NAME=authentik

# ---------- PostgREST ----------
# 与 Authentik 签发 token 的校验密钥对齐（白皮书 2.2 Skill 2）
PGRST_JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long

# ---------- Authentik ----------
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key-50-chars-minimum
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin-password

# ---------- Mercure（Realtime）----------
MERCURE_JWT_KEY=change-me-mercure-jwt-key

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
